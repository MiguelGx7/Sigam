# Copia este archivo a backend/.env y llena los valores.
# .\dev.ps1 -Setup lo genera solo si no existe.

DB_NAME=sigam
DB_USER=sigam_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# TLS contra MySQL. Dejar comentado = usa backend/certs/ca.pem si existe,
# y si no existe se conecta sin TLS (util para un MySQL local de desarrollo).
# Poner una ruta para usar otro CA, o DB_SSL_CA= (vacio) para desactivarlo siempre.
#DB_SSL_CA=
